                <mxCell id="legal_units" value="&lt;div align=&quot;center&quot; style=&quot;font-size:15px;font-weight:bold;color:#92400E;margin-bottom:4px;&quot;&gt;legal_units&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #FCD34D;margin:4px 0 8px 0;&quot;/&gt;&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt;&lt;/font&gt; &lt;b&gt;id&lt;/b&gt; : BINARY(16)&lt;br/&gt;&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;[FK]&lt;/b&gt;&lt;/font&gt; &lt;b&gt;document_id&lt;/b&gt; : BINARY(16) NOT NULL&lt;br/&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;[UQ]&lt;/b&gt;&lt;/font&gt; &lt;b&gt;unit_id&lt;/b&gt; : VARCHAR(500) NOT NULL UNIQUE&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;data&lt;/b&gt; : LONGTEXT NOT NULL (JSON)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;published&lt;/b&gt; : BOOLEAN DEFAULT FALSE&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;version&lt;/b&gt; : BIGINT DEFAULT 0 (@Version)&lt;br/&gt;&lt;hr style=&quot;border:none;border-top:1px dashed #FDE68A;margin:6px 0;&quot;/&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;* INDEX(document_id)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#78350F;align=left;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;shadow=1;" parent="1" vertex="1">
