        </mxCell>
        <mxCell id="policyCell_8_1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#E7F5ED;strokeColor=#D7E0EA;strokeWidth=1;fontColor=#1C4B35;fontFamily=Arial;fontSize=20;fontStyle=1;" value="✓" vertex="1">
