          <mxGeometry height="74" width="1617" x="60" y="943" as="geometry" />
        </mxCell>
        <mxCell id="sid_v20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#E9F4EA;strokeColor=#A9CDAE;fontColor=#336C43;" value="KAG hasSign remains LegalUnit → TrafficSign. This integration adds NO extra KAG node type or predicate. Separate stores use app/ETL lookup, not a real cross-database relationship." vertex="1">
          <mxGeometry height="67" width="1617" x="60" y="1036" as="geometry" />
        </mxCell>
