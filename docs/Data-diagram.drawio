        <mxCell id="policyCell_8_0" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=17;fillColor=#EAF2FA;strokeColor=#D7E0EA;strokeWidth=1;fontColor=#566A7C;fontFamily=Arial;fontSize=16;fontStyle=0;" value="Gán USER ↔ POLICE, khóa/mở tài khoản" vertex="1">
