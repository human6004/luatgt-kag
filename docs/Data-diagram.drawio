        </mxCell>
        <mxCell id="registration" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CAD6E3;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="225" width="735" x="70" y="865" as="geometry" />
        </mxCell>
        <mxCell id="registration_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#285575;spacing=0;" value="01 · Đăng ký tài khoản" vertex="1">
          <mxGeometry height="40" width="691" x="92" y="880" as="geometry" />
        </mxCell>
        <mxCell id="registration_body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#354E64;spacing=0;" value="POST /api/.../register → APP_USER.role = USER (server tự gán); enabled = true (theo chính sách mặc định); auth_version = 0. Client không được tự đăng ký POLICE hoặc ADMIN." vertex="1">
          <mxGeometry height="150" width="690" x="93" y="932" as="geometry" />
        </mxCell>
        <mxCell id="rolechange" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CAD6E3;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="225" width="735" x="856" y="865" as="geometry" />
        </mxCell>
        <mxCell id="rolechange_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#285575;spacing=0;" value="02 · Admin cập nhật tài khoản" vertex="1">
          <mxGeometry height="40" width="691" x="878" y="880" as="geometry" />
        </mxCell>
        <mxCell id="rolechange_body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#354E64;spacing=0;" value="PATCH /api/admin/users/{id}  {&quot;role&quot;:&quot;POLICE&quot;} hoặc {&quot;role&quot;:&quot;USER&quot;}; enabled dùng để khóa/mở. Chỉ ADMIN gọi được API; ADMIN target không đổi quyền/khóa qua endpoint." vertex="1">
          <mxGeometry height="150" width="690" x="879" y="932" as="geometry" />
        </mxCell>
        <mxCell id="revocation" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CAD6E3;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="225" width="735" x="1642" y="865" as="geometry" />
        </mxCell>
        <mxCell id="revocation_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#285575;spacing=0;" value="03 · Thu hồi token khi đổi quyền" vertex="1">
          <mxGeometry height="40" width="691" x="1664" y="880" as="geometry" />
        </mxCell>
        <mxCell id="revocation_body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#354E64;spacing=0;" value="Trong một transaction: cập nhật role → tăng auth_version → thu hồi refresh session → ghi AUDIT_EVENT. Bộ xác thực kiểm tra version + enabled để từ chối cả access token cũ; đăng nhập lại." vertex="1">
          <mxGeometry height="150" width="690" x="1665" y="932" as="geometry" />
        </mxCell>
        <mxCell id="migration" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CAD6E3;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="218" width="1120" x="70" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="migration_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#285575;spacing=0;" value="04 · Migration V4" vertex="1">
          <mxGeometry height="40" width="1076" x="92" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="migration_body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#354E64;spacing=0;" value="Mở rộng enum/check từ USER, ADMIN → USER, POLICE, ADMIN (tùy trạng thái schema cũ). Bảo toàn role/enabled và tài khoản cũ; không tự đổi người dùng thành POLICE." vertex="1">
          <mxGeometry height="143" width="1075" x="93" y="1187" as="geometry" />
        </mxCell>
        <mxCell id="bootstrap" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CAD6E3;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="218" width="1136" x="1241" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="bootstrap_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#285575;spacing=0;" value="05 · ADMIN bootstrap &amp; giới hạn API" vertex="1">
          <mxGeometry height="40" width="1092" x="1263" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="bootstrap_body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#354E64;spacing=0;" value="ADMIN chỉ có từ cơ chế bootstrap sẵn có. Không cho update hoặc disable ADMIN qua PATCH này; không cho set role=ADMIN ở request. API tài khoản, hạ tầng, cấu hình KAG chỉ ADMIN." vertex="1">
          <mxGeometry height="143" width="1091" x="1264" y="1187" as="geometry" />
        </mxCell>
        <mxCell id="policy_bottom" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#8A5116;spacing=0;" value="Chú ý: mô hình minh họa chính sách API và kiểm soát truy cập. Nếu backend dùng JWT không đối chiếu auth_version khi xác thực, việc tăng version KHÔNG tự thu hồi access token đã phát hành." vertex="1">
          <mxGeometry height="76" width="2280" x="74" y="1412" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
