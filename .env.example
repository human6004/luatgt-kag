# Copy to .env; fill blanks with independent random secrets (32 bytes each).
# Protect .env; never commit it. Prepare token files per docs/INSTALL.md.
COMPOSE_PROJECT_NAME=luatgt
ADMIN_EMAIL=admin@luatgt.local
ADMIN_PASSWORD=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_PASSWORD=
KAG_MYSQL_PASSWORD=
KAG_NEO4J_PASSWORD=
KAG_MINIO_PASSWORD=
# Local secrets/state are ignored by Git and Docker builds; never commit them.
KAG_STATE_DIR=./.secrets
KAG_CREDENTIALS_WRITE_SECRET_FILE=../luatgt-state/credentials-write.token
KAG_PROVIDER_TEST_SECRET_FILE=../luatgt-state/provider-test.token
KAG_CONFIG_APPLY_SECRET_FILE=../luatgt-state/config-apply.token
# Shared API/Builder/OpenSPG Embedding egress; enable only with approved provider endpoints.
KAG_PROVIDER_ENABLED=0
# Public HTTPS hosts: docker/kag-ingress/provider-hosts.lst (shared by clients and gateway).
# Optional proxy URL registered explicitly; empty means public providers only.
KAG_PROVIDER_PROXY_BASE_URL=
# Only the optional proxy route needs verified retry/rotation/fallback policy.
KAG_CHAT_PROXY_TEST_SAFE=0
# Alternative: operator explicitly accepts retries/fallback within this registered proxy.
KAG_CHAT_PROXY_ALLOW_UPSTREAM_RETRIES=0
# Legacy target hints before a project is saved on the Builder UI.
# Project selection now uses the signed-in OpenSPG owner's catalog, by ID.
KAG_BUILDER_PROJECT_ID=
KAG_BUILDER_PROJECT_NAME=
KAG_BUILDER_DATABASE=
# Destructive UI disabled by default. Grant only a verified dedicated physical database.
# JSON array: [{"project_id":123,"database_id":"physical-database-id-from-Neo4j"}]
KAG_BUILDER_CLEAR_TARGETS=[]
# Trusted deployment endpoints; browser requests cannot change these.
KAG_BUILDER_OPENSPG_URL=http://openspg-server:8887
KAG_BUILDER_NEO4J_HTTP=http://openspg-neo4j:7474
KAG_BUILDER_NEO4J_URI=bolt://openspg-neo4j:7687
# Browser URLs, without credentials. Use the same hostname as LuatGT for login cookies.
KAG_OPENSPG_PUBLIC_URL=http://127.0.0.1:8887/
KAG_NEO4J_BROWSER_URL=http://127.0.0.1:7474/browser/
KAG_NEO4J_PUBLIC_BOLT_URL=bolt://127.0.0.1:7687
