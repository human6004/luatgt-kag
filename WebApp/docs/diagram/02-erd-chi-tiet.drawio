  <diagram id="account-chat" name="01 · Tài khoản và chat">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1140" pageHeight="2008" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="accounts" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;overflow=hidden;fillColor=#E7EEF9;strokeColor=#42679B;strokeWidth=2;fontSize=24;fontFamily=Consolas;" value="accounts&#10;──────────────────────────────────────&#10;PK  id : BINARY(16)&#10;UQ  email : VARCHAR(254)&#10;    password : VARCHAR(100)&#10;    name : VARCHAR(100)&#10;    role : VARCHAR(10)&#10;    enabled : BOOLEAN&#10;    token_version : INTEGER&#10;──────────────────────────────────────&#10;UQ (email)&#10;CHECK(role IN ('USER','POLICE','ADMIN'))" vertex="1">
          <mxGeometry height="426" width="960" x="80.0" y="240.0" as="geometry" />
        </mxCell>
        <mxCell id="chat_messages" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;overflow=hidden;fillColor=#E7EEF9;strokeColor=#42679B;strokeWidth=2;fontSize=24;fontFamily=Consolas;" value="chat_messages&#10;──────────────────────────────────────&#10;PK  id : BINARY(16)&#10;FK  owner_id : BINARY(16)&#10;    question : LONGTEXT&#10;    answer : LONGTEXT ?&#10;    citations : LONGTEXT&#10;    state : VARCHAR(20)&#10;    created_at : DATETIME(6)&#10;    feedback : VARCHAR(20) ?&#10;    feedback_note : VARCHAR(1000) ?&#10;    resolved : BOOLEAN&#10;    resolution : VARCHAR(1000) ?" vertex="1">
          <mxGeometry height="502" width="960" x="80.0" y="1186.0" as="geometry" />
        </mxCell>
        <mxCell id="fk3" edge="1" parent="1" source="accounts" style="rounded=0;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=20;fontFamily=Arial;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontColor=#51627A;startFill=0;endFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#75859A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" target="chat_messages" value="FK04">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="560.0" y="926.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="doc_title" parent="1" vertex="1" value="01 · Tài khoản và chat" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=32;fontColor=#25364B;strokeColor=none;fillColor=none;fontStyle=1;">
          <mxGeometry as="geometry" x="80" y="28" width="1400" height="52" />
        </mxCell>
        <mxCell id="doc_source" parent="1" vertex="1" value="Nguồn: SQL migrations V1–V6; Java migration V4; code hiện tại · cập nhật 02/11/2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="90" width="1400" height="35" />
        </mxCell>
        <mxCell id="doc_legend" parent="1" vertex="1" value="PK: khóa chính · FK: khóa ngoại · UQ: duy nhất · ?: NULL · ||: đúng 1 · o|: 0..1 · o{: 0..N" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="132" width="1400" height="32" />
        </mxCell>
        <mxCell id="doc_legend2" parent="1" vertex="1" value="Nét liền: FK SQL; nét đứt: quan hệ/đối chiếu trong code. Khung nét đứt: bảng tham chiếu từ trang khác. Trang KAG dùng cạnh đồ thị riêng." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="172" width="1400" height="45" />
        </mxCell>
        <mxCell id="doc_notes" parent="1" vertex="1" value="• Role sau V4: USER / POLICE / ADMIN. JWT được kiểm tra token_version; không có bảng session riêng.&#10;• chat_messages lưu từng lượt hỏi/đáp. citations là JSON trong LONGTEXT; căn cứ doc_id/unit_id được kiểm trong ChatService, không phải FK&#10;SQL.&#10;• FKxx là mã quan hệ trong sơ đồ, không phải tên constraint trong database:&#10;• FK04: chat_messages(owner_id) → accounts(id)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="1753.0" width="1400" height="170" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
