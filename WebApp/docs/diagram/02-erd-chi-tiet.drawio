        <mxCell id="doc_source" parent="1" vertex="1" value="Nguồn: SQL migrations V1–V6; Java migration V4; code hiện tại · cập nhật 02/11/2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="90" width="4200.0" height="35" />
        </mxCell>
        <mxCell id="doc_legend" parent="1" vertex="1" value="PK: khóa chính · FK: khóa ngoại · UQ: duy nhất · ?: NULL · ||: đúng 1 · o|: 0..1 · o{: 0..N" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="132" width="4200.0" height="32" />
        </mxCell>
        <mxCell id="doc_legend2" parent="1" vertex="1" value="Nét liền: FK SQL; nét đứt: quan hệ/đối chiếu trong code. Khung nét đứt: bảng tham chiếu từ trang khác. Trang KAG dùng cạnh đồ thị riêng." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="172" width="4200.0" height="45" />
        </mxCell>
        <mxCell id="doc_notes" parent="1" vertex="1" value="• question.question_id dùng lại UUID quản trị trong content. sourceExternalId giữ mã gốc; mã quản trị khi nhập được tách theo bộ.&#10;• question_revision và answer_option không bị sửa tại chỗ. Câu đã có lượt luyện/thi muốn thay đổi phải xuất bản vào bộ mới.&#10;• Ngày ban hành/hiệu lực chưa xác minh được để NULL. LEGACY giữ dữ liệu trước nâng cấp, không phải đợt ban hành chính thức.&#10;• Các cột release_id/set_id/revision_id bổ sung phục vụ FK ghép. question_asset.media_url là khóa đối tượng MinIO, ảnh được tải qua API có&#10;kiểm quyền.&#10;• FKxx là mã quan hệ trong sơ đồ, không phải tên constraint trong database:&#10;• FK10: question_set(release_id) → bank_release(release_id)&#10;• FK11: topic(release_id) → bank_release(release_id)&#10;• FK12: question(question_id) → content(id)&#10;• FK13: question_revision(question_id) → question(question_id)&#10;• FK14: answer_option(revision_id) → question_revision(revision_id)&#10;• FK15: question_asset(revision_id) → question_revision(revision_id)&#10;• FK16: set_question(set_id, release_id) → question_set(set_id, release_id)&#10;• FK17: set_question(topic_id, release_id) → topic(topic_id, release_id)&#10;• FK18: set_question(revision_id) → question_revision(revision_id)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="3537.0" width="1600" height="450" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
