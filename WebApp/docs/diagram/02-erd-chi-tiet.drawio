        <mxCell id="doc_title" parent="1" vertex="1" value="08 · KAG và đối chiếu định danh" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=32;fontColor=#25364B;strokeColor=none;fillColor=none;fontStyle=1;">
