        <mxCell id="doc_title" parent="1" vertex="1" value="05 · Lượt thi, đáp án và lượt luyện" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=32;fontColor=#25364B;strokeColor=none;fillColor=none;fontStyle=1;">
          <mxGeometry as="geometry" x="80" y="28" width="2904.0" height="52" />
        </mxCell>
        <mxCell id="doc_source" parent="1" vertex="1" value="Nguồn: SQL migrations V1–V6; Java migration V4; code hiện tại · cập nhật 02/11/2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="90" width="2904.0" height="35" />
        </mxCell>
        <mxCell id="doc_legend" parent="1" vertex="1" value="PK: khóa chính · FK: khóa ngoại · UQ: duy nhất · ?: NULL · ||: đúng 1 · o|: 0..1 · o{: 0..N" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="132" width="2904.0" height="32" />
        </mxCell>
        <mxCell id="doc_legend2" parent="1" vertex="1" value="Nét liền: FK SQL; nét đứt: quan hệ/đối chiếu trong code. Khung nét đứt: bảng tham chiếu từ trang khác. Trang KAG dùng cạnh đồ thị riêng." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="172" width="2904.0" height="45" />
        </mxCell>
        <mxCell id="doc_notes" parent="1" vertex="1" value="• FK ghép bảo đảm câu thuộc bộ của rule và option thuộc revision đã phát. attempt_answer PK chỉ attempt_question_id: mỗi câu chọn tối đa một&#10;đáp án.&#10;• study_attempt giữ option đã chọn, revision, đúng/sai và thời điểm. Chủ đề/chương suy ra qua set_question → topic, không lặp cột chapter.&#10;• Server giữ thời gian, chấm điểm và kiểm quyền sở hữu. Quy tắc, phiên bản và khóa ảnh cũ được giữ để xem/chấm bài cũ.&#10;• FKxx là mã quan hệ trong sơ đồ, không phải tên constraint trong database:&#10;• FK23: exam_attempt(user_id) → accounts(id)&#10;• FK24: exam_attempt(rule_id, set_id) → exam_rule(rule_id, set_id)&#10;• FK25: attempt_question(attempt_id, set_id) → exam_attempt(attempt_id, set_id)&#10;• FK26: attempt_question(set_question_id, set_id) → set_question(set_question_id, set_id)&#10;• FK27: attempt_question(set_question_id, revision_id) → set_question(set_question_id, revision_id)&#10;• FK28: attempt_answer(attempt_question_id, revision_id) → attempt_question(attempt_question_id, revision_id)&#10;• FK29: attempt_answer(option_id, revision_id) → answer_option(option_id, revision_id)&#10;• FK30: study_attempt(user_id) → accounts(id)&#10;• FK31: study_attempt(set_question_id, revision_id) → set_question(set_question_id, revision_id)&#10;• FK32: study_attempt(selected_option_id, revision_id) → answer_option(option_id, revision_id)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#25364B;strokeColor=none;fillColor=none;">
          <mxGeometry as="geometry" x="80" y="3299.0" width="1600" height="450" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
