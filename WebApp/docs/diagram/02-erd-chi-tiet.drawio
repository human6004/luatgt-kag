  <diagram id="attempt-study" name="05 · Lượt thi, đáp án và lượt luyện">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="3084" pageHeight="3834" math="0" shadow="0" background="#FFFFFF">
